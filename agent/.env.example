# Copy this file to .env and set your values. Never commit .env.

# Account that pays (required for the pay command).
X402_ACCOUNT_ADDRESS=

# Private key for that account (required to approve a payment). Anyone with this
# key controls the account's funds, so use a dedicated account with a small balance.
X402_PRIVATE_KEY=

# Base JSON-RPC endpoint (optional).
# BASE_RPC_URL=https://mainnet.base.org
