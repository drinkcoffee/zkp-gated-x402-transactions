# Copy this file to .env and set your values. Never commit .env.

# Where proofs are generated: network (Succinct Prover Network), cpu, or mock.
# Mock proofs are for testing and cannot be verified on Base.
SP1_PROVER=network

# Key of the account that requests and pays for proofs on the Succinct Prover Network.
NETWORK_PRIVATE_KEY=

# Base JSON-RPC endpoint used to check proofs (optional).
# BASE_RPC_URL=https://mainnet.base.org
