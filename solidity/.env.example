# Base JSON-RPC endpoint, for deploying and for the fork tests.
BASE_RPC_URL=https://mainnet.base.org
# Etherscan API key, for verifying the contract source on Basescan.
ETHERSCAN_API_KEY=

# Values set when the contract is deployed.
OWNER=
TREASURY=
X402_CLIENT=
# The circuit's verification key, printed by zkp-prove as arguments.programVKey.
PROGRAM_VKEY=
